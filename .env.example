# Database connection string (SQLite for zero-config local setup, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# Optional Steam Web API Key (Get from https://steamcommunity.com/dev/apikey)
# If empty, GamePace runs in real-time simulated mode with full search capabilities
STEAM_API_KEY=""

# Secret for authentication (Optional)
NEXTAUTH_SECRET="gamepace_super_secret_key_123"
